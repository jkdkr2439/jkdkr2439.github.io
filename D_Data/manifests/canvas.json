{
  "version": 1,
  "default_domain": "basic-epistemology",
  "zones": [
    {"key": "anchor", "module": "knowledge-domains"},
    {"key": "context", "module": "context-tree"},
    {"key": "stage", "module": "content-stage"}
  ],
  "modules": [
    {
      "key": "knowledge-domains",
      "zone": "anchor",
      "input": ["domains", "domain", "language"],
      "process": "select-domain",
      "output": ["canvas.select-domain"],
      "dependencies": ["canvas-registry", "canvas-store"]
    },
    {
      "key": "context-tree",
      "zone": "context",
      "input": ["domain", "contextCollapsed", "language"],
      "process": "render-domain-context",
      "output": ["canvas.toggle-context", "show-post", "show-book"],
      "dependencies": ["canvas-registry", "canvas-store", "post-registry", "book-manifest"]
    },
    {
      "key": "content-stage",
      "zone": "stage",
      "input": ["route", "language"],
      "process": "render-existing-reader",
      "output": ["canvas.sync-route"],
      "dependencies": ["post-registry", "book-manifest", "content-router"]
    },
    {
      "key": "companion",
      "zone": "stage",
      "input": ["route", "readerState", "viewport", "motionPreference"],
      "process": "render-bounded-companion-state",
      "output": ["companion.ready", "companion.hidden", "companion.fault"],
      "dependencies": ["companion-registry", "content-stage"]
    }
  ],
  "domains": [
    {
      "key": "basic-epistemology",
      "label_vi": "Nhận Thức Luận Căn Bản",
      "label_en": "Basic Epistemology",
      "source": {"type": "tag", "value": "Nhận thức luận căn bản"},
      "pinned": true
    },
    {
      "key": "power",
      "label_vi": "Quyền lực",
      "label_en": "Power",
      "source": {"type": "tag", "value": "Quyền lực"}
    },
    {
      "key": "criticism",
      "label_vi": "Phản biện",
      "label_en": "Criticism",
      "source": {"type": "tag", "value": "Phản biện"}
    },
    {
      "key": "machine-intelligence",
      "label_vi": "Trí năng máy",
